# Supabase project > Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend API key and signing secret from your email.received webhook
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Must match the domain configured for inbound receiving in Resend
MAIL_DOMAIN=mail.example.com

# Generate a long random value; set the same value in Vercel Cron configuration
CRON_SECRET=replace-with-a-long-random-secret

# Optional: inbox lifetime in minutes (default 60)
INBOX_TTL_MINUTES=60
